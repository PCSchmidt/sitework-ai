# Slow-path agent container (M3). Node 22 (prime-agent supervisor) + Python 3.11 (IPython
# kernel) + uv, non-root, pinned prime-agent version.
#
# Built and verified working (spike-01, 2026-09-17): image builds, `prime-agent --version`
# and a real stdin/stdout RPC round trip both work inside the container.
#
# IMPORTANT (spike-01 finding, elevates docs/prime-agent-feasibility.md risk F9 from "Low"):
# prime-agent is NOT on the public npm registry -- its own package.json has
# "private": true. `npm install -g prime-agent@x.y.z` (the original draft of this
# file) fails everywhere except a machine that happens to have it globally installed
# already. Until there's a real private registry (GitHub Packages / CI-published
# artifact) with build-time auth, this Dockerfile installs from a vendored tarball
# instead: `npm pack` the verified local install, drop the .tgz in docker/vendor/
# (gitignored -- see docker/vendor/README.md), rebuild. This is a real gap to close
# before this image is reproducible on any machine other than the one that built it.
#
# Also spike-01: docs/07 says "Node.js >= 20", but prime-agent's own package.json
# declares "engines": {"node": ">=22.8.0"} -- a real doc/reality gap. node:20 installs
# with an EBADENGINE warning (not a hard failure) but this image pins Node 22 to match
# what the package actually requires rather than what the docs assumed.
FROM node:22.11-bookworm-slim

ENV PYTHONUNBUFFERED=1
ARG PRIME_AGENT_VERSION=0.9.3

# spike-01 finding: `curl ... | sh` swallows curl's exit code through the pipe, so a
# DNS/network blip made this step silently no-op (image "built" with no uv at all)
# instead of failing the build. set -e in a bash -c wrapper plus an explicit
# post-install check makes a broken install a hard build failure instead.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3.11 python3.11-venv curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && bash -c "set -euo pipefail; curl -LsSf https://astral.sh/uv/install.sh | sh" \
    && /root/.local/bin/uv --version \
    && cp /root/.local/bin/uv /usr/local/bin/uv  # root's $HOME isn't readable by `node` (USER below)

# Vendored install (see note above) -- upgrade only with a fresh tarball + a green
# contract test (docs/07 §3 contract-agent.yaml, created after this spike per docs/12).
COPY docker/vendor/prime-agent-${PRIME_AGENT_VERSION}.tgz /tmp/prime-agent.tgz
RUN npm install -g /tmp/prime-agent.tgz && rm /tmp/prime-agent.tgz

# node:22-bookworm-slim already ships a uid-1000 "node" user; reuse it rather than
# colliding on --uid 1000 (spike-01 finding: useradd fails "UID 1000 is not unique").
RUN mkdir -p /workspace /app && chown node:node /workspace /app
USER node
WORKDIR /app

# M4: this container now runs agent/worker.py (the actual queue dispatcher), not just
# a bare `prime-agent` RPC probe -- the spike only needed prime-agent itself. `uv` was
# already installed above (as root) for the prime-agent-runtime's own kernel-side shim;
# copied to /usr/local/bin so the non-root `node` user can run it too.
#
# Deliberately NOT `uv sync` against the full pyproject.toml/uv.lock: that would pull
# in torch/torchvision/ultralytics (the vision worker's CUDA stack, ~5 GB) even though
# agent/worker.py never imports them -- confirmed by checking `sys.modules` after
# `import agent.worker` (docs/12 M4 notes). Matches how Dockerfile.vision/Dockerfile.web
# already hand-pick their own minimal package lists rather than syncing the shared
# lockfile; this is that same pattern, not a new one.
RUN uv venv .venv \
    && uv pip install --python .venv/bin/python \
       pydantic>=2.7 pyyaml>=6.0 redis>=5.0 asyncpg>=0.29

COPY --chown=node:node agent/ ./agent/
COPY --chown=node:node pipelines/ ./pipelines/
COPY --chown=node:node config/ ./config/
# agent/persistence.py reuses api/db.py + api/repository.py rather than a
# second copy of the same SQL (docs/06 "single source of truth" applies to
# the DB boundary too) -- api/main.py's own fastapi/websockets imports are
# never triggered since nothing here imports the `api.main` submodule.
COPY --chown=node:node api/ ./api/

# Stays at /app (not /workspace): `python -m agent.worker` resolves the
# `agent` package against the current working directory, so cwd has to be
# where `agent/` actually lives -- confirmed by an earlier build that set
# WORKDIR /workspace here and failed with ModuleNotFoundError at runtime.
# /workspace is still where the worker writes incident payload files, via
# the --workspace-root argument below, not via cwd.
# /root/.prime equivalent (harness state) is mounted at /home/node/.prime in this image.
CMD ["/app/.venv/bin/python3", "-m", "agent.worker", \
     "--workspace-root", "/workspace", "--evidence-root", "/workspace/incidents"]
