# FastAPI delivery plane (M0 stub; real REST+WS in M4).
FROM python:3.11.11-slim-bookworm

ENV PYTHONUNBUFFERED=1
WORKDIR /app

RUN pip install --no-cache-dir uv
COPY pyproject.toml ./
RUN uv pip install --system --no-cache fastapi uvicorn pydantic pyyaml

COPY api ./api
COPY pipelines ./pipelines
COPY config ./config

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
