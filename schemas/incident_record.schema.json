{
  "$defs": {
    "AgentRunStats": {
      "additionalProperties": false,
      "properties": {
        "model": {
          "title": "Model",
          "type": "string"
        },
        "tokens_in": {
          "minimum": 0,
          "title": "Tokens In",
          "type": "integer"
        },
        "tokens_out": {
          "minimum": 0,
          "title": "Tokens Out",
          "type": "integer"
        },
        "turns": {
          "minimum": 0,
          "title": "Turns",
          "type": "integer"
        },
        "wall_ms": {
          "minimum": 0,
          "title": "Wall Ms",
          "type": "integer"
        }
      },
      "required": [
        "model",
        "tokens_in",
        "tokens_out",
        "turns",
        "wall_ms"
      ],
      "title": "AgentRunStats",
      "type": "object"
    },
    "Classification": {
      "enum": [
        "normal_ops",
        "near_miss",
        "violation",
        "false_positive"
      ],
      "title": "Classification",
      "type": "string"
    },
    "KinematicsVerdict": {
      "additionalProperties": false,
      "description": "Agent output \u2014 verified kinematics (docs/06 \u00a73).",
      "properties": {
        "verified_min_distance_m": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified Min Distance M"
        },
        "closing_velocity_mps": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Closing Velocity Mps"
        },
        "ttc_s": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ttc S"
        },
        "classification": {
          "$ref": "#/$defs/Classification"
        },
        "recompute_inputs": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Recompute Inputs",
          "type": "object"
        }
      },
      "required": [
        "classification"
      ],
      "title": "KinematicsVerdict",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Slow path \u2192 Band-3 gate \u2192 DB (docs/06 \u00a73).",
  "properties": {
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "camera_id": {
      "title": "Camera Id",
      "type": "string"
    },
    "trigger_ts": {
      "title": "Trigger Ts",
      "type": "number"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "classification": {
      "$ref": "#/$defs/Classification"
    },
    "verified_kinematics": {
      "$ref": "#/$defs/KinematicsVerdict"
    },
    "narrative_md": {
      "default": "",
      "title": "Narrative Md",
      "type": "string"
    },
    "rule_citations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Rule Citations",
      "type": "array"
    },
    "recommended_actions": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Recommended Actions",
      "type": "array"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "agent_run": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentRunStats"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "event_id",
    "camera_id",
    "trigger_ts",
    "severity",
    "classification",
    "verified_kinematics"
  ],
  "title": "IncidentRecord",
  "type": "object"
}
